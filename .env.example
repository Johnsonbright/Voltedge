# VoltEdge Electronics Environment Variables

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# n8n Webhook Configuration
# The Next.js server route forwards orders to n8n with the shared secret header
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/voltedge-orders
N8N_WEBHOOK_TEST_URL=https://your-n8n-instance.com/webhook-test/voltedge-orders
N8N_WEBHOOK_SECRET=voltedge_super_secret_shared_token_2026
N8N_ENVIRONMENT=test

# Development & Fallback Simulation
# When set to true (or when N8N_WEBHOOK_URL is not yet configured in local dev),
# the server route provides a high-fidelity local mock engine matching the n8n contract
# so all edge-case scenarios (thresholds, over-stock review, idempotency, etc.) can be tested immediately.
ENABLE_MOCK_WEBHOOK=true

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
