# VoltEdge Electronics Environment Variables

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPER_ADMIN_EMAIL=admin@example.com

# n8n Webhook Configuration
# The Next.js server route forwards orders to n8n with the shared secret header
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/voltedge-orders
N8N_WEBHOOK_TEST_URL=https://your-n8n-instance.com/webhook-test/voltedge-orders
N8N_WEBHOOK_SECRET=
N8N_ENVIRONMENT=test

# Set to true only for local testing without the n8n workflow. Keep false in production.
ENABLE_MOCK_WEBHOOK=true

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
